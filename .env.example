# Local PostgreSQL credentials. Change these outside local development.
DB_USER=postgres
DB_PASSWORD=change-this-local-password
DB_NAME=devsync
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_TIMEZONE=UTC

# Local Redis is private to the Compose network. Set a password for shared environments.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# Generate unique random values for each secret before deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Optional SMTP configuration for email verification and password resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@devsync.com

# Browser-facing URLs. These Vite values are embedded when the frontend builds.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=

BACKEND_PORT=8080
FRONTEND_PORT=5173
ENV=development
